#!/bin/bash
#
# postinstall: @APP_NAME@ 写入完成后, 把分发版自带的默认配置和
# CTranslate2 模型从 SharedSupport 复制到用户 Rime 目录, 然后
# 沿用上游的注册 / 部署 / 启用流程.
#
# 资源在 .app 里的位置 (由 package/build-pkg 注入):
#   @APP_NAME@/Contents/SharedSupport/ai-predict-defaults/*.custom.yaml
#   @APP_NAME@/Contents/SharedSupport/predict_models/zh-base-ct2-int8/
#
# 用户目标位置 (Bangke 私有目录, 不与鼠须管共用的 ~/Library/Rime 混):
#   ~/Library/BangkePinyin/{default,luna_pinyin}.custom.yaml
#   ~/Library/BangkePinyin/predict_models/zh-base-ct2-int8/
#

set -e

LOGIN_USER=$(/usr/bin/stat -f%Su /dev/console)
LOGIN_HOME=$(/usr/bin/dscl . -read "/Users/${LOGIN_USER}" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
[ -n "${LOGIN_HOME}" ] || LOGIN_HOME="/Users/${LOGIN_USER}"

BANGKE_DIR="${LOGIN_HOME}/Library/BangkePinyin"
LOG_DIR="${LOGIN_HOME}/Library/Logs/BangkePinyin"
mkdir -p "${LOG_DIR}"
# 安装脚本以 root 跑, 建出来的目录属主会是 root; 而输入法进程以登录用户身份运行,
# 不 chown 的话它写不进 RIME_LOG_DIR, 运行时日志会静默丢失(只剩 root 写的 install.log)。
/usr/sbin/chown "${LOGIN_USER}:staff" "${LOG_DIR}"
LOG="${LOG_DIR}/install.log"

APP_NAME="@APP_NAME@"
APP_ROOT="${DSTROOT}/${APP_NAME}"
APP_BIN="${APP_ROOT}/Contents/MacOS/${APP_NAME%.app}"
SHARED="${APP_ROOT}/Contents/SharedSupport"

DEFAULTS_SRC="${SHARED}/ai-predict-defaults"
RIME_ICE_SRC="${SHARED}/rime-ice"
MODEL_SRC="${SHARED}/predict_models/zh-base-ct2-int8"
MODEL_DST="${BANGKE_DIR}/predict_models/zh-base-ct2-int8"

echo "[$(date '+%F %T')] postinstall start, user=${LOGIN_USER}" >> "${LOG}"

mkdir -p "${BANGKE_DIR}"

if [ -d "${DEFAULTS_SRC}" ]; then
    # Install the shipped files, but carry over the values the settings window
    # owns (menu/page_size, ascii_composer/switch_key/*, the ai_predict block).
    # The engine wiring in these same files is replaced unconditionally: it has
    # to track the bundled plugins. The merge lives in the app binary so the
    # YAML editing rules have one implementation, shared with the settings
    # window. Falling back to a plain copy keeps a merge failure from leaving
    # the user with no AI wiring at all.
    echo "[postinstall] installing default custom.yaml(s)" >> "${LOG}"
    for f in default.custom.yaml luna_pinyin.custom.yaml rime_ice.custom.yaml; do
        [ -f "${DEFAULTS_SRC}/${f}" ] || continue
        if "${APP_BIN}" --install-custom-config "${DEFAULTS_SRC}/${f}" "${BANGKE_DIR}/${f}"; then
            echo "[postinstall] merged ${f} (kept user-set values)" >> "${LOG}"
        else
            echo "[postinstall] merge failed for ${f}, falling back to plain copy" >> "${LOG}"
            cp "${DEFAULTS_SRC}/${f}" "${BANGKE_DIR}/${f}"
        fi
    done
    # Soft-write: bangke.custom.yaml only controls the panel's appearance
    # (font/color scheme/accent_text_color etc.). Existing users may
    # have hand-tuned this file; we don't want to silently overwrite their
    # font choices just to set our accent color. So we only seed it when the
    # file is truly absent. Existing users can opt in by following the README
    # "可选: 让 AI 候选的 'AI' 字样以强调色显示" section manually.
    if [ -f "${DEFAULTS_SRC}/bangke.custom.yaml" ] && [ ! -f "${BANGKE_DIR}/bangke.custom.yaml" ]; then
        echo "[postinstall] seeding bangke.custom.yaml (no existing one found)" >> "${LOG}"
        cp "${DEFAULTS_SRC}/bangke.custom.yaml" "${BANGKE_DIR}/bangke.custom.yaml"
    elif [ -f "${BANGKE_DIR}/bangke.custom.yaml" ]; then
        echo "[postinstall] keeping user's existing bangke.custom.yaml" >> "${LOG}"
    fi

    # Extended dictionary (rime-ice core shards). These are
    # data files we ship and own, so hard-overwrite: copy the dict definition
    # and its cn_dicts/ shards into the user dir. luna_pinyin.custom.yaml
    # points translator/dictionary at luna_pinyin.extended, so --build below
    # compiles and mounts it automatically.
    if [ -d "${DEFAULTS_SRC}/dicts" ]; then
        echo "[postinstall] installing extended dictionary (luna_pinyin.extended + cn_dicts)" >> "${LOG}"
        cp -R "${DEFAULTS_SRC}/dicts/." "${BANGKE_DIR}/"
    else
        echo "[postinstall] no dicts/ in defaults, skipping extended dictionary" >> "${LOG}"
    fi
else
    echo "[postinstall] WARN: no ${DEFAULTS_SRC}, skipping defaults" >> "${LOG}"
fi

# 雾凇拼音(rime-ice)全拼方案: schema + melt_eng/radical_pinyin 词库 + lua
# + en_dicts + opencc(emoji) 硬覆盖铺到用户目录。cn_dicts 已由上方
# dicts/ 一并铺好(同一套 rime-ice 核心分片), 这里不再重复处理。
if [ -d "${RIME_ICE_SRC}" ]; then
    echo "[postinstall] installing rime-ice (雾凇拼音) scheme" >> "${LOG}"
    cp -R "${RIME_ICE_SRC}/." "${BANGKE_DIR}/"
else
    echo "[postinstall] no ${RIME_ICE_SRC}, skipping 雾凇拼音 scheme" >> "${LOG}"
fi

# Include generation settings so decoder-only updates reach existing installs.
model_fingerprint() {
    /usr/bin/shasum -a 256 "$1/model.bin" 2>/dev/null | awk '{print $1}'
    if [ -f "$1/generation_config.json" ]; then
        /usr/bin/shasum -a 256 "$1/generation_config.json" | awk '{print $1}'
    else
        echo "-"
    fi
}

if [ -f "${MODEL_SRC}/model.bin" ]; then
    if [ -f "${MODEL_DST}/model.bin" ] && \
       [ "$(model_fingerprint "${MODEL_SRC}")" = "$(model_fingerprint "${MODEL_DST}")" ]; then
        echo "[postinstall] model already up to date, skip copy" >> "${LOG}"
    else
        echo "[postinstall] model differs, refreshing -> ${MODEL_DST}" >> "${LOG}"
        rm -rf "${MODEL_DST}"
        mkdir -p "${MODEL_DST}"
        cp -R "${MODEL_SRC}/." "${MODEL_DST}/"
    fi
else
    echo "[postinstall] WARN: no model at ${MODEL_SRC}, skipping" >> "${LOG}"
fi

echo "[postinstall] chowning ${BANGKE_DIR} to ${LOGIN_USER}" >> "${LOG}"
/usr/sbin/chown -R "${LOGIN_USER}:staff" "${BANGKE_DIR}"

# 替换 bundle 会触发系统重启输入法; 它启动时发现 build/ 被清也会自行全量
# 部署, 与下面的 --build 抢同一个用户目录。先禁用输入源把输入法压下去,
# 部署完再启用+选中, 保证只有一个部署执行者。
/usr/bin/sudo -u "${LOGIN_USER}" "${APP_BIN}" --disable-input-source || true
/usr/bin/killall "${APP_NAME%.app}" >/dev/null 2>&1 || true

"${APP_BIN}" --register-input-source

if [ -z "${RIME_NO_PREBUILD}" ]; then
    # 以登录用户跑: user_data_dir 按 uid 解析, root 跑会落到 /var/root,
    # 而且部署产物会以 root 属主落在用户目录里。
    /usr/bin/sudo -u "${LOGIN_USER}" "${APP_BIN}" --build \
        || echo "[postinstall] WARN: --build returned non-zero" >> "${LOG}"
fi

/usr/bin/sudo -u "${LOGIN_USER}" "${APP_BIN}" --enable-input-source || true
/usr/bin/sudo -u "${LOGIN_USER}" "${APP_BIN}" --select-input-source || true

echo "[$(date '+%F %T')] postinstall done" >> "${LOG}"
exit 0
