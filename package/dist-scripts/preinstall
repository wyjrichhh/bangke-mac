#!/bin/bash
#
# preinstall: 在 @APP_NAME@ 写入前, 安全清理 Bangke 私有用户目录里
# 与本分发版冲突的配置, 但保留用户的标识/词库/学习记忆.
#
# 只碰 ~/Library/BangkePinyin, 绝不动 ~/Library/Rime —— 那是鼠须管等
# Rime 发行版的地盘, 动它等于污染别人家的配置.
#
# 保留:
#   installation.yaml   用户的 Rime 安装 ID
#   user.yaml           用户偏好 (主题/快捷键等)
#   *.userdb / *.userdb.txt   词库与学习记忆
#   全部 *.custom.yaml  交由 postinstall 合并, 用户改过的值不丢
#
# 重置:
#   build/               (旧的 deploy 产物, 让本次重新生成)
#
# 整个用户目录会先被完整复制到 ~/Library/BangkePinyin.backup-<ts>/ 兜底.
#

set -e

LOGIN_USER=$(/usr/bin/stat -f%Su /dev/console)
LOGIN_HOME=$(/usr/bin/dscl . -read "/Users/${LOGIN_USER}" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
[ -n "${LOGIN_HOME}" ] || LOGIN_HOME="/Users/${LOGIN_USER}"

BANGKE_DIR="${LOGIN_HOME}/Library/BangkePinyin"
LOG_DIR="${LOGIN_HOME}/Library/Logs/BangkePinyin"
mkdir -p "${LOG_DIR}"
# 安装脚本以 root 跑, 建出来的目录属主会是 root; 而输入法进程以登录用户身份运行,
# 不 chown 的话它写不进 RIME_LOG_DIR, 运行时日志会静默丢失(只剩 root 写的 install.log)。
/usr/sbin/chown "${LOGIN_USER}:staff" "${LOG_DIR}"
LOG="${LOG_DIR}/install.log"

echo "[$(date '+%F %T')] preinstall start, user=${LOGIN_USER} home=${LOGIN_HOME}" >> "${LOG}"

if [ -d "${BANGKE_DIR}" ]; then
    STAMP=$(date +%Y%m%d-%H%M%S)
    BACKUP="${LOGIN_HOME}/Library/BangkePinyin.backup-${STAMP}"

    echo "[preinstall] backing up ${BANGKE_DIR} -> ${BACKUP} (只含用户数据)" >> "${LOG}"
    # 只备份**用户自己的东西**：predict_models/（模型）、rime-ice/（雾凇方案）、dicts/（扩展
    # 词库）、build/ 都是包里自带、可再生的（模型还由 sha 指纹管理），备份它们纯属浪费 ——
    # 实测每份备份 415MB、其中 230MB 是模型副本，17 次安装攒了 13.8GB。排除后每份只剩几 MB。
    mkdir -p "${BACKUP}"
    /usr/bin/sudo -u "${LOGIN_USER}" /usr/bin/rsync -a \
        --exclude 'predict_models/' --exclude 'rime-ice/' --exclude 'dicts/' \
        --exclude 'build/' --exclude 'sync/' \
        "${BANGKE_DIR}/" "${BACKUP}/" >> "${LOG}" 2>&1
    /bin/cat > "${BACKUP}/BACKUP-README.txt" <<'BKEOF'
安装前的用户数据备份（只含你自己的东西）。
  含：  *.custom.yaml、user.yaml、installation.yaml、*.userdb（词典与学习记忆）
  不含：predict_models/（模型）、rime-ice/（雾凇方案）、dicts/（扩展词库）、build/（部署产物）
        —— 这些包里自带、可再生，重新安装时由 postinstall 重新铺。
恢复：把这里的文件拷回 ~/Library/BangkePinyin/ 即可。
BKEOF
    /usr/sbin/chown -R "${LOGIN_USER}:staff" "${BACKUP}" 2>/dev/null || true

    # 只保留最近 3 份。以前没有保留策略 —— 装 N 次就攒 N 份（实测 17 份 / 13.8GB）。
    # 只认我们自己这个命名前缀，别的一概不碰。
    BACKUP_KEEP=3
    ls -dt "${LOGIN_HOME}"/Library/BangkePinyin.backup-* 2>/dev/null \
        | tail -n +$((BACKUP_KEEP + 1)) \
        | while IFS= read -r old; do
            echo "[preinstall] pruning old backup ${old}" >> "${LOG}"
            rm -rf "${old}"
        done

    # These files are NOT removed. postinstall merges the shipped engine wiring
    # into them while keeping the values the user set in the settings window, so
    # it needs them to still be here. Deleting them would silently reset
    # menu/page_size, the Shift key bindings and every ai_predict option.

    if [ -d "${BANGKE_DIR}/build" ]; then
        echo "[preinstall] removing stale build/ (will be regenerated)" >> "${LOG}"
        rm -rf "${BANGKE_DIR}/build"
    fi
fi

echo "[$(date '+%F %T')] preinstall done" >> "${LOG}"
exit 0
