#!/bin/bash
#
# preinstall: 在 @APP_NAME@ 写入前, 安全清理用户 Rime 目录里
# 与本分发版冲突的配置, 但保留用户的标识/词库/学习记忆.
#
# 保留:
#   installation.yaml   用户的 Rime 安装 ID
#   user.yaml           用户偏好 (主题/快捷键等)
#   *.userdb / *.userdb.txt   词库与学习记忆
#   全部 *.custom.yaml  交由 postinstall 合并, 用户改过的值不丢
#
# 重置:
#   build/               (旧的 deploy 产物, 让本次重新生成)
#
# 整个用户 Rime 目录会先被完整复制到 ~/Library/Rime.backup-<ts>/ 兜底.
#

set -e

LOGIN_USER=$(/usr/bin/stat -f%Su /dev/console)
LOGIN_HOME=$(/usr/bin/dscl . -read "/Users/${LOGIN_USER}" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
[ -n "${LOGIN_HOME}" ] || LOGIN_HOME="/Users/${LOGIN_USER}"

RIME_DIR="${LOGIN_HOME}/Library/Rime"
LOG_DIR="${LOGIN_HOME}/Library/Logs/BangkePinyin"
mkdir -p "${LOG_DIR}"
# 安装脚本以 root 跑, 建出来的目录属主会是 root; 而输入法进程以登录用户身份运行,
# 不 chown 的话它写不进 RIME_LOG_DIR, 运行时日志会静默丢失(只剩 root 写的 install.log)。
/usr/sbin/chown "${LOGIN_USER}:staff" "${LOG_DIR}"
LOG="${LOG_DIR}/install.log"

echo "[$(date '+%F %T')] preinstall start, user=${LOGIN_USER} home=${LOGIN_HOME}" >> "${LOG}"

if [ -d "${RIME_DIR}" ]; then
    STAMP=$(date +%Y%m%d-%H%M%S)
    BACKUP="${LOGIN_HOME}/Library/Rime.backup-${STAMP}"

    echo "[preinstall] backing up ${RIME_DIR} -> ${BACKUP}" >> "${LOG}"
    /usr/bin/sudo -u "${LOGIN_USER}" /bin/cp -R "${RIME_DIR}" "${BACKUP}"

    # These files are NOT removed. postinstall merges the shipped engine wiring
    # into them while keeping the values the user set in the settings window, so
    # it needs them to still be here. Deleting them would silently reset
    # menu/page_size, the Shift key bindings and every ai_predict option.

    if [ -d "${RIME_DIR}/build" ]; then
        echo "[preinstall] removing stale build/ (will be regenerated)" >> "${LOG}"
        rm -rf "${RIME_DIR}/build"
    fi
fi

echo "[$(date '+%F %T')] preinstall done" >> "${LOG}"
exit 0
