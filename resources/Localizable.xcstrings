{
  "sourceLanguage": "en",
  "strings": {
    "1 is fully transparent, 0 is opaque.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 = 全透明，0 = 不透明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 = 全透明，0 = 不透明。"
          }
        }
      }
    },
    "A new update is available": {
      "comment": "Update",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有新版本"
          }
        }
      }
    },
    "AI Prediction": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能联想"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧聯想"
          }
        }
      }
    },
    "AI candidates must sit below the search range to appear.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选位置需小于去重扫描范围，否则不会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選位置需小於去重掃描範圍，否則不會出現。"
          }
        }
      }
    },
    "AI examples show appearance and position, not actual model output.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 示例用于预览样式与位置，不代表真实模型输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 範例用於預覽樣式與位置，不代表真實模型輸出。"
          }
        }
      }
    },
    "AI-only candidates": {
      "localizations": {
        "zh-Hans": {
